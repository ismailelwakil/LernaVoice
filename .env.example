# ------------------------------------------------------------------------- #
# LERNA Voice AI Service — example environment
# Copy to .env and fill in. NEVER commit a real .env.
# ------------------------------------------------------------------------- #

# --- service ------------------------------------------------------------- #
APP_ENV=development                 # development | production | test
PORT=8080
LOG_LEVEL=INFO
SERVICE_NAME=lerna-voice-ai
CORS_ORIGINS=http://localhost:3000
EXPOSE_DEV_DIAGNOSTICS=true         # set false in production

# --- service-to-service auth (§45) --------------------------------------- #
VOICE_SERVICE_API_KEY=              # shared secret the LERNA backend sends
VOICE_AUTH_REQUIRED=false           # true in production

# --- provider routing (§17) ---------------------------------------------- #
VOICE_PROVIDER_MODE=auto            # auto | gemini_only | elevenlabs_only | deepgram_only
VOICE_FALLBACK_ENABLED=true
VOICE_MAX_RETRIES=2
VOICE_RETRY_BACKOFF=0.4             # seconds, exponential
VOICE_PROVIDER_TIMEOUT=20           # seconds
VOICE_CIRCUIT_BREAKER_THRESHOLD=3
VOICE_CIRCUIT_BREAKER_COOLDOWN=60
VOICE_ENABLE_MOCK_PROVIDERS=false   # dev/demo only: synthetic audio, no vendor calls
LLM_PRIORITY=openrouter,gemini      # lesson "brain": winner first, the other as fallback
VOICE_PRIORITY=azure,gemini,elevenlabs,fish   # spoken voice: Azure 1st, Gemini 2nd, ElevenLabs 3rd

# --- Gemini (primary) ----------------------------------------------------- #
# Two auth paths, auto-detected. Leave the one you do not use blank.
# A) Vertex AI / Agent Platform  (service account or ADC)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=     # /path/to/service-account.json
# B) Gemini Developer API (AIza... key) — then set GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=

# Vertex path uses GEMINI_VERTEX_LIVE_MODEL; Developer API path uses GEMINI_LIVE_MODEL.
GEMINI_VERTEX_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_NAME=Kore
# Native-audio live models can adapt their tone to how the student sounds.
GEMINI_AFFECTIVE_DIALOG=true
# Let the model speak up when it has something useful to add (off: a tutor answers,
# it does not fill every silence).
GEMINI_PROACTIVE_AUDIO=false

# --- ElevenLabs (backup #1: STT + TTS components) ------------------------- #
#: Azure AI Speech — free F0 tier: 0.5M characters/month (≈ 8 hours) of neural TTS.
#: Create a *Microsoft* "Speech" resource (not a marketplace listing) with pricing
#: tier Free F0, then copy KEY 1 and the region shown under "Keys and Endpoint".
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_SPEED=1.05
#: Humanising the voice: expressive style, pitch lift, pauses between sentences.
#: A voice that refuses the style is retried un-styled once and remembered.
AZURE_TTS_STYLE=cheerful
AZURE_TTS_PITCH=2.0
AZURE_TTS_PAUSES=true
#: Per-language voice overrides, e.g. ar:ar-SA-HamedNeural,en:en-US-JennyNeural
AZURE_VOICE_OVERRIDES=
#: Fish Audio — backup TTS voice (round 27). Free `s2.1-pro-free` model auto-detects
#: the language (83 languages, Arabic included). Bearer token; documented languages
#: only (en ar fr sw). Slower than Azure on long lines (non-streaming REST).
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
#: ElevenLabs voices: the free plan refuses *library* voices through the API
#: (HTTP 402), so probe first: python3 tools/verify_elevenlabs_voice.py en
ELEVENLABS_VOICE_ID=
#: auto = stream the languages the streaming model covers, REST (one call per line)
#: for the rest · rest = always REST (v4-family quality, slower first audio) · stream
ELEVENLABS_TRANSPORT=auto
#: Slightly brisker than an announcement; 1.0 is ElevenLabs' own default.
ELEVENLABS_SPEECH_SPEED=1.05
#: Voice for the *offline* demo — a real TTS vendor can speak the mock dialogue.
#: auto = ElevenLabs when ELEVENLABS_API_KEY is set · off · elevenlabs (require it).
VOICE_DEMO_VOICE=auto

# --- Deepgram (backup #2: STT + TTS components, en/fr only for TTS) ------- #
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- persistence ---------------------------------------------------------- #
VOICE_PERSISTENCE_BACKEND=auto      # auto | mongo | memory
MONGODB_URI=                        # mongodb+srv://USER:PASSWORD@cluster/...
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=lerna_voice

# --- LERNA integration (RAG, Progress Profile, Orchestrator) -------------- #
LERNA_INTEGRATION_MODE=auto         # auto | inprocess | http | disabled
LERNA_AI_SERVICE_PATH=              # path to <Lerna>/ai-service for in-process import
LERNA_BACKEND_URL=http://localhost:8000   # http mode only
LERNA_BACKEND_API_KEY=
ACADEMIC_OS_DATA_DIR=               # in-process mode: LERNA data directory
LERNA_RAG_TOP_K=6

# --- audio ---------------------------------------------------------------- #
INPUT_SAMPLE_RATE=16000             # PCM16 mono, little-endian (client -> service)
OUTPUT_SAMPLE_RATE=24000            # PCM16 mono, little-endian (service -> client)
VOICE_STORE_RAW_AUDIO=false
VOICE_STORE_TRANSCRIPTS=true

# --- learner profiles (level mirror) -------------------------------------- #
# Where each student's level is remembered until LERNA's Progress Profile is
# the source of truth. Empty keeps it in memory (what the tests use).
LEARNER_PROFILE_PATH=demo-data/learner_profiles.json

# --- demo harness --------------------------------------------------------- #
VOICE_SERVICE_URL=http://localhost:8080
